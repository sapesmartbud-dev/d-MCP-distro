#!/bin/sh
# SAPÉ d-MCP — desktop-menu launcher (installed by the .deb and .rpm packages).
#
# The three databases are created in the current working directory
# (src/sape_d_mcp/db_location.py). A desktop menu starts programs from an arbitrary
# directory, so the menu entry goes through this script, which switches to a fixed
# per-user data directory first. Running `sape-d-mcp` from a terminal bypasses it and
# keeps the terminal's own directory, as documented in the README.
set -e
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/sape/d-mcp"
mkdir -p "$DATA_DIR"
cd "$DATA_DIR"
exec /opt/sape-d-mcp/sape-d-mcp "$@"
